# Export these variables, or run: uvicorn backend.main:app --env-file .env  (requires python-dotenv).
# The app does not read this file by itself. The placeholder below is REJECTED at runtime: set your own value (12+ chars).
# Required before first run; choose a long, unique password.
HIRESHIELD_ADMIN_PASSWORD=change-this-before-starting
HIRESHIELD_OLLAMA_MODEL=qwen2.5:3b
HIRESHIELD_DB=hireshield.db
HIRESHIELD_OLLAMA_TIMEOUT=120
HIRESHIELD_CLAM_TIMEOUT=90
# HIRESHIELD_YARA_DIR=detection/yara
